# frozen_string_literal: true

# ActiveRecord adapter tests against Rails 7.1. CI runs one job per gemfile
# in this directory (see .github/workflows/ci.yml). To run locally:
#   BUNDLE_GEMFILE=gemfiles/rails_7.1.gemfile bundle exec rake test:active_record

source "https://rubygems.org"

gemspec path: ".."

gem "i18n", ">= 1.14"
gem "minitest", ">= 5.0", "< 6.0"
gem "rake", ">= 13.0"
gem "rspec", ">= 3.13"

gem "activerecord", "~> 7.1.0"
gem "pg", ">= 1.5"
gem "railties", "~> 7.1.0"
# Rails 7.1 needs sqlite3 1.x, whose precompiled gems stop at Ruby 3.3; build
# it from source so the same lockfile installs on Ruby 3.4 too.
gem "sqlite3", "~> 1.4", force_ruby_platform: true
