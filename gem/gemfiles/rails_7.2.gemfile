# frozen_string_literal: true

# ActiveRecord adapter tests against Rails 7.2. CI runs one job per gemfile
# in this directory (see .github/workflows/ci.yml). To run locally:
#   BUNDLE_GEMFILE=gemfiles/rails_7.2.gemfile bundle exec rake test:active_record

source "https://rubygems.org"

gemspec path: ".."

gem "i18n", ">= 1.14"
gem "minitest", ">= 5.0", "< 6.0"
gem "rake", ">= 13.0"
gem "rspec", ">= 3.13"

gem "activerecord", "~> 7.2.0"
gem "pg", ">= 1.5"
gem "railties", "~> 7.2.0"
gem "sqlite3", ">= 1.4"
