# frozen_string_literal: true

# ActiveRecord adapter tests against Rails 7.2. CI runs one job per gemfile
# in this directory (see .github/workflows/ci.yml). To run locally:
#   BUNDLE_GEMFILE=gemfiles/rails_7.2.gemfile bundle exec rake test:active_record

source "https://rubygems.org"

gemspec path: ".."

gem "i18n", ">= 1.14"
gem "minitest", ">= 5.0", "< 6.0"
gem "rake", ">= 13.0"
gem "rspec", ">= 3.13"

gem "activerecord", "~> 7.2.0"
gem "pg", ">= 1.5"
gem "railties", "~> 7.2.0"
# sqlite3 1.x built from source, as in rails_7.1.gemfile. The lockfile is made
# on Ruby 3.1, where sqlite3 2.x's precompiled gems stop before Ruby 4.0, and
# building 2.x from source fails on Ruby 3.1: its extconf reads YAML and loads
# Ruby 3.1's psych.rb against the bundle's newer psych extension. SQLite is only
# the test database here.
gem "sqlite3", "~> 1.4", force_ruby_platform: true

# Railties pulls in nokogiri. The lockfile is made on Ruby 3.1, the oldest
# Ruby in the matrix, which resolves nokogiri 1.18; its precompiled gems stop
# before Ruby 4.0. Build it from source so the same lockfile installs on 4.0.
gem "nokogiri", force_ruby_platform: true
